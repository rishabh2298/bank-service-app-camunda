<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_1" targetNamespace="http://camunda.org/examples" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:process id="simpleProcess" name="Simple Process" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="startEvent" name="MainDepositCreditEvent">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="endEvent" name="End">
      <bpmn:incoming>Flow_0sc9x6z</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="startEvent" targetRef="GoingToBankId" />
    <bpmn:sequenceFlow id="Flow_1lr6j1q" sourceRef="GoingToBankId" targetRef="Gateway_09bz1sj" />
    <bpmn:userTask id="GoingToBankId" name="Going to the Bank" camunda:formKey="camunda-forms:/form/way-to-get-to-the-bank.form">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_1lr6j1q</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_09bz1sj" name="taxi or walk ?">
      <bpmn:incoming>Flow_1lr6j1q</bpmn:incoming>
      <bpmn:outgoing>Flow_0qeb7cj</bpmn:outgoing>
      <bpmn:outgoing>Flow_0r7zpvy</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0qeb7cj" name="Walk" sourceRef="Gateway_09bz1sj" targetRef="GetTicketInQueueMachineId">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${transportMode=='walk'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="PayForTheTaxi" name="Pay for the taxi" camunda:delegateExpression="${taxiPaymentDelegate}">
      <bpmn:incoming>Flow_0r7zpvy</bpmn:incoming>
      <bpmn:outgoing>Flow_0nuc6c4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0r7zpvy" name="Taxi" sourceRef="Gateway_09bz1sj" targetRef="PayForTheTaxi">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${transportMode=='taxi'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1ttmpoe" sourceRef="GetTicketInQueueMachineId" targetRef="Gateway_0tece43" />
    <bpmn:sequenceFlow id="Flow_0nuc6c4" sourceRef="PayForTheTaxi" targetRef="GetTicketInQueueMachineId" />
    <bpmn:exclusiveGateway id="Gateway_0tece43" name="Deposite or Credit">
      <bpmn:incoming>Flow_1ttmpoe</bpmn:incoming>
      <bpmn:outgoing>Flow_1fuhyb9</bpmn:outgoing>
      <bpmn:outgoing>Flow_0mfpbnt</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1fuhyb9" name="Ticket deposite" sourceRef="Gateway_0tece43" targetRef="DepositeOpeningProcessId">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ticket=='deposite'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0mfpbnt" name="Ticket Credit" sourceRef="Gateway_0tece43" targetRef="CreditObtainingProcessId">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ticket=='credit'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:callActivity id="CreditObtainingProcessId" name="Get a credit" calledElement="Process_CreditObtaining">
      <bpmn:extensionElements>
        <camunda:in variables="all" />
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0mfpbnt</bpmn:incoming>
      <bpmn:outgoing>Flow_1ma5qc9</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="DepositeOpeningProcessId" name="OpenDeposite" calledElement="DepositeOpening">
      <bpmn:extensionElements>
        <camunda:in variables="all" />
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1fuhyb9</bpmn:incoming>
      <bpmn:outgoing>Flow_0wnqiri</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gateway_0y93unp">
      <bpmn:incoming>Flow_0wnqiri</bpmn:incoming>
      <bpmn:incoming>Flow_1ma5qc9</bpmn:incoming>
      <bpmn:outgoing>Flow_1n3w9nz</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0wnqiri" sourceRef="DepositeOpeningProcessId" targetRef="Gateway_0y93unp" />
    <bpmn:sequenceFlow id="Flow_1ma5qc9" sourceRef="CreditObtainingProcessId" targetRef="Gateway_0y93unp" />
    <bpmn:sequenceFlow id="Flow_1n3w9nz" sourceRef="Gateway_0y93unp" targetRef="ActivityRoadToHomeId" />
    <bpmn:sequenceFlow id="Flow_0sc9x6z" sourceRef="ActivityRoadToHomeId" targetRef="endEvent" />
    <bpmn:callActivity id="ActivityRoadToHomeId" name="Road to Home" calledElement="GoingHomeProcess">
      <bpmn:extensionElements>
        <camunda:in variables="all" />
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1n3w9nz</bpmn:incoming>
      <bpmn:outgoing>Flow_0sc9x6z</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:userTask id="GetTicketInQueueMachineId" name="GetTicketInQueueMachine" camunda:formKey="camunda-forms:/form/queue-machine.form">
      <bpmn:incoming>Flow_0qeb7cj</bpmn:incoming>
      <bpmn:incoming>Flow_0nuc6c4</bpmn:incoming>
      <bpmn:outgoing>Flow_1ttmpoe</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:textAnnotation id="TextAnnotation_12sn38b">
      <bpmn:text>Camunda form - choose transport to the bank (walking or taxi ?)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1d3xymw" associationDirection="None" sourceRef="GoingToBankId" targetRef="TextAnnotation_12sn38b" />
    <bpmn:textAnnotation id="TextAnnotation_052msyc">
      <bpmn:text>If taxi then reduce money from wallet</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1sgx1dm" associationDirection="None" sourceRef="PayForTheTaxi" targetRef="TextAnnotation_052msyc" />
    <bpmn:textAnnotation id="TextAnnotation_164dwxc">
      <bpmn:text>Choose ticket in queue machine  Deposite or Credit</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1r02l89" associationDirection="None" sourceRef="GetTicketInQueueMachineId" targetRef="TextAnnotation_164dwxc" />
    <bpmn:textAnnotation id="TextAnnotation_0sd5zyn">
      <bpmn:text>Process of deposite opening</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1ejwoz0" associationDirection="None" sourceRef="DepositeOpeningProcessId" targetRef="TextAnnotation_0sd5zyn" />
    <bpmn:textAnnotation id="TextAnnotation_1lohczv">
      <bpmn:text>Process of credit opening</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1iybm37" associationDirection="None" sourceRef="CreditObtainingProcessId" targetRef="TextAnnotation_1lohczv" />
    <bpmn:textAnnotation id="TextAnnotation_0f4vqup">
      <bpmn:text>Choose transport to go home</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0sjal82" associationDirection="None" sourceRef="ActivityRoadToHomeId" targetRef="TextAnnotation_0f4vqup" />
  </bpmn:process>
